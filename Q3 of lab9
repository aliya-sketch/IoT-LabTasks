class Calculator:
    def __init__(self, num1, num2):
        self.num1 = num1
        self.num2 = num2
#methods...
    def add(self):
        return self.num1 + self.num2

    def sub(self):
        return self.num1 - self.num2

    def multip(self):
        return self.num1 * self.num2

    def divis(self):
        return self.num1 / self.num2

# Object... 
calc = Calculator(19, 6)

print("Addition:", calc.add())
print("Subtraction:", calc.sub())
print("Multiplication:", calc.multip())
print("Division:", calc.divis())